{
  "schemaVersion": "lastudio.example.v1",
  "id": "tts-short-en-announcement",
  "title": "English short announcement",
  "task": "tts",
  "model": { "familyId": null, "required": false },
  "capabilities": ["tts", "en"],
  "inputs": {
    "text": "Welcome back. Your project is ready for review."
